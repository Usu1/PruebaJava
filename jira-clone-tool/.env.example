# Copia este fichero a ".env" y rellena los valores. No subas ".env" al repo.

# --- Jira origen (p. ej. madrid-es.atlassian.net, Jira Cloud) ---
SRC_JIRA_URL=https://madrid-es.atlassian.net
SRC_JIRA_EMAIL=tu-email@dominio.com
# API token de Jira Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
SRC_JIRA_TOKEN=

# --- Jira destino (p. ej. jira.indra.es, Jira Server/Data Center) ---
DST_JIRA_URL=https://jira.indra.es
# "bearer" (Personal Access Token) o "basic" (usuario + token/contraseña)
DST_JIRA_AUTH_TYPE=bearer
DST_JIRA_USER=
DST_JIRA_TOKEN=

# Solo si jira.indra.es usa un certificado autofirmado o de una CA interna
# y Python no lo reconoce (SSLCertVerificationError). Opciones:
#   - ruta a un .pem con la CA interna, p. ej. C:\certs\indra-ca.pem
#   - "false" para desactivar la verificación TLS (inseguro, solo pruebas puntuales)
# Déjalo vacío si no da error de certificado.
DST_JIRA_CA_BUNDLE=

# Project key destino por defecto (se puede sobreescribir con --target-project)
DST_PROJECT=IAMNAM

# Id del custom field "Key Client" en el destino (p. ej. customfield_10500).
# Si se deja vacío, el script lo busca automáticamente por nombre.
DST_JIRA_KEY_CLIENT_FIELD=
